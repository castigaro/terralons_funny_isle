{
	"description": "Invalid variants of the real data/feedback.json and data/balance/feedback.json: each case sets (or deletes) one value at a path and expects an error containing the text.",
	"cases": [
		{"name": "unknown_signal_key", "file": "feedback", "path": ["signals", "not_a_signal"], "value": {"default": []}, "expect": "signals.not_a_signal: not a custom EventBus signal"},
		{"name": "node_builtin_signal_key", "file": "feedback", "path": ["signals", "ready"], "value": {"default": []}, "expect": "signals.ready: not a custom EventBus signal"},
		{"name": "unclassified_signal", "file": "feedback", "path": ["no_visual", "settings_changed"], "delete": true, "expect": "signal settings_changed is neither mapped nor listed in no_visual"},
		{"name": "mapped_and_no_visual", "file": "feedback", "path": ["no_visual", "castaway_step"], "value": "both", "expect": "signals.castaway_step: also listed in no_visual"},
		{"name": "missing_asset", "file": "feedback", "path": ["signals", "animal_fled", "default", 0, "asset"], "value": "res://assets/graphics/emotes/PNG/Vector/Style 1/emote_nope.png", "expect": "missing asset"},
		{"name": "deny_listed_asset", "file": "feedback", "path": ["signals", "object_thrown", "default", 0, "asset"], "value": "res://assets/graphics/particles/PNG/muzzle_01.png", "expect": "matches the deny list"},
		{"name": "folder_not_in_asset_map", "file": "feedback", "path": ["signals", "animal_fled", "default", 0, "asset"], "value": "res://assets/graphics/topdown-characters/PNG/Man Blue/manBlue_stand.png", "expect": "is not named in docs/asset_map.md"},
		{"name": "unknown_material", "file": "feedback", "path": ["signals", "object_landed", "variants", "mud", 0, "material"], "value": "ketchup", "expect": "unknown material 'ketchup'"},
		{"name": "extra_material", "file": "feedback", "path": ["materials", "ketchup"], "value": "#7a5230", "expect": "materials must be exactly mud, sand, water"},
		{"name": "red_material", "file": "feedback", "path": ["materials", "mud"], "value": "#c01818", "expect": "is red-dominant"},
		{"name": "splat_without_material", "file": "feedback", "path": ["signals", "object_landed", "variants", "mud", 0, "material"], "delete": true, "expect": "a splat needs a material"},
		{"name": "missing_word_key", "file": "feedback", "path": ["signals", "object_bonked", "default", 0, "word"], "value": "fx.nope", "expect": "unknown i18n key 'fx.nope'"},
		{"name": "word_too_long", "file": "feedback", "path": ["signals", "object_bonked", "default", 0, "word"], "value": "core.title", "expect": "longer than 8 characters"},
		{"name": "unknown_entry_key", "file": "feedback", "path": ["signals", "object_bonked", "default", 0, "colour"], "value": "red", "expect": "colour: unknown key"},
		{"name": "unknown_effect", "file": "feedback", "path": ["signals", "object_bonked", "default", 0, "effect"], "value": "laser", "expect": "unknown effect 'laser'"},
		{"name": "unknown_strength", "file": "feedback", "path": ["signals", "object_bonked", "default", 1, "strength"], "value": "mega", "expect": "balance strengths.shake.mega missing"},
		{"name": "missing_event_warning", "file": "feedback", "path": ["events", "wave_wash", "warning"], "delete": true, "expect": "events.wave_wash.warning: every event type needs a warning entry"},
		{"name": "unknown_event_type", "file": "feedback", "path": ["events", "dragon_attack"], "value": {"warning": []}, "expect": "events.dragon_attack: unknown event type"},
		{"name": "required_without_visual", "file": "feedback", "path": ["signals", "object_used", "default"], "value": [], "expect": "signal object_used needs at least one visual entry"},
		{"name": "unknown_balance_key", "file": "balance", "path": ["sparkle_level"], "value": 3, "expect": "balance.sparkle_level: unknown key"},
		{"name": "unknown_nested_balance_key", "file": "balance", "path": ["caps", "lasers"], "value": 3, "expect": "balance.caps.lasers: unknown key"},
		{"name": "missing_balance_key", "file": "balance", "path": ["popup_seconds"], "delete": true, "expect": "balance.popup_seconds: missing"},
		{"name": "hitstop_81_ms", "file": "balance", "path": ["strengths", "hitstop", "bonk", "ms"], "value": 81, "expect": "strengths.hitstop.bonk.ms: 81 exceeds"},
		{"name": "hitstop_max_above_80", "file": "balance", "path": ["hitstop_max_ms"], "value": 120, "expect": "hitstop_max_ms: 120 must be <= 80"},
		{"name": "cooldown_below_duration", "file": "balance", "path": ["hitstop_cooldown_ms"], "value": 20, "expect": "hitstop_cooldown_ms: 20 is shorter than the longest hit-stop"},
		{"name": "time_scale_zero", "file": "balance", "path": ["hitstop_time_scale"], "value": 0, "expect": "hitstop_time_scale: 0 must be > 0"},
		{"name": "time_scale_one", "file": "balance", "path": ["hitstop_time_scale"], "value": 1, "expect": "hitstop_time_scale: 1 must be < 1"},
		{"name": "reduce_factor_too_high", "file": "balance", "path": ["reduce_motion_factor"], "value": 0.3, "expect": "reduce_motion_factor: 0.3 must be <= 0.25"},
		{"name": "fx_scale_above_one", "file": "balance", "path": ["fx_scale"], "value": 1.5, "expect": "fx_scale: 1.5 must be <= 1"},
		{"name": "popup_too_long", "file": "balance", "path": ["popup_seconds"], "value": 1.5, "expect": "popup_seconds: 1.5 must be <= 1.2"},
		{"name": "emote_too_long", "file": "balance", "path": ["emote_seconds"], "value": 3, "expect": "emote_seconds: 3 must be <= 2.0"},
		{"name": "flash_alpha_too_high", "file": "balance", "path": ["strengths", "flash", "task", "alpha"], "value": 0.5, "expect": "strengths.flash.task.alpha: 0.5 exceeds 0.4"},
		{"name": "flash_interval_too_short", "file": "balance", "path": ["flash_min_interval_ms"], "value": 100, "expect": "flash_min_interval_ms: 100 must be >= 334"},
		{"name": "cap_zero", "file": "balance", "path": ["caps", "popup"], "value": 0, "expect": "caps.popup: 0 must be >= 1"},
		{"name": "strength_missing_field", "file": "balance", "path": ["strengths", "shake", "bonk", "trauma"], "delete": true, "expect": "strengths.shake.bonk.trauma: missing or not a number"}
	]
}
