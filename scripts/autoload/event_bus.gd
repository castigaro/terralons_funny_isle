extends Node
## Global signal hub that decouples gameplay, feedback, audio and HUD.
## Contract: typed signals only, extended additively (never rename or retype a signal); no registry,
## no register() and no plugin or feature lookup. Emitters call EventBus.<signal>.emit(...).

@warning_ignore("unused_signal")
signal level_started(level_id: String)
@warning_ignore("unused_signal")
signal level_timer_tick(seconds_left: float)
@warning_ignore("unused_signal")
signal task_completed(level_id: String, task_id: String)
@warning_ignore("unused_signal")
signal all_required_done(level_id: String)
@warning_ignore("unused_signal")
signal level_won(level_id: String, stars: int)
@warning_ignore("unused_signal")
signal level_lost(level_id: String, open_tasks: Array)
@warning_ignore("unused_signal")
signal event_triggered(event_id: String)
@warning_ignore("unused_signal")
signal object_grabbed(kind: String)
@warning_ignore("unused_signal")
signal object_thrown(kind: String)
@warning_ignore("unused_signal")
signal object_bonked(kind: String, cause: String)
@warning_ignore("unused_signal")
signal settings_changed(key: String)
@warning_ignore("unused_signal")
signal castaway_dashed(position: Vector2, direction: Vector2)
@warning_ignore("unused_signal")
signal castaway_step(position: Vector2, surface: String)
@warning_ignore("unused_signal")
signal object_used(kind: String, target_kind: String)
@warning_ignore("unused_signal")
signal object_landed(kind: String, position: Vector2, surface: String)
@warning_ignore("unused_signal")
signal castaway_dizzy_started(cause: String)
@warning_ignore("unused_signal")
signal castaway_dizzy_ended()
@warning_ignore("unused_signal")
signal interact_verb_changed(verb: String, target_kind: String)
@warning_ignore("unused_signal")
signal task_progress(level_id: String, task_id: String, current: int, target: int)
@warning_ignore("unused_signal")
signal timer_warning(level_id: String, seconds_left: float)
@warning_ignore("unused_signal")
signal event_ended(event_id: String)
# Animal and item reactions (BI-4); kind is the animal or item kind from data/animals.json or data/items.json.
@warning_ignore("unused_signal")
signal animal_fled(kind: String)
@warning_ignore("unused_signal")
signal animal_bonked(kind: String, cause: String)
@warning_ignore("unused_signal")
signal animal_panicked(kind: String)
@warning_ignore("unused_signal")
signal animal_caught(kind: String)
@warning_ignore("unused_signal")
signal animal_lured(kind: String)
@warning_ignore("unused_signal")
signal entity_lost(kind: String, reason: String)
@warning_ignore("unused_signal")
signal entity_respawned(kind: String, position: Vector2)
@warning_ignore("unused_signal")
signal level_restarted(level_id: String)
