extends MenuScreen
## Short credits screen (D-2): the asset authors of assets/SOURCES.md grouped by author with their packs and
## licence, read from data/credits.json (generated by tools/build_credits.py). Any key or click after a short guard
## returns; Esc as well.

signal back_pressed

const CREDITS_PATH := "res://data/credits.json"

var groups: Array = []
var hint_label: Label
var author_labels: Array = []
var pack_labels: Array = []


func _build() -> void:
	guard_s = float(cfg.get("credits_guard_s", 0))
	var box := make_panel()
	box.add_child(make_label("menu.credits.title", {}, MenuTheme.VARIATION_HEADING))
	box.add_child(make_wrapping_label("menu.credits.intro"))
	var res := JsonStore.read(CREDITS_PATH)
	if res["status"] == JsonStore.STATUS_OK and res["data"] is Dictionary and res["data"].get("groups") is Array:
		groups = res["data"]["groups"]
	for group in groups:
		if not group is Dictionary:
			continue
		var author := Label.new()
		author.theme_type_variation = MenuTheme.VARIATION_ACCENT
		author.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		author.text = String(group.get("author", ""))
		box.add_child(author)
		author_labels.append(author)
		var names := PackedStringArray()
		var licences := {}
		for pack in group.get("packs", []):
			names.append(String(pack.get("pack", "")))
			licences[String(pack.get("licence", ""))] = true
		var packs := make_wrapping_label("")
		# Pack lists use the smallest menu font, so every SOURCES.md row still fits on a 1280x720 screen.
		packs.add_theme_font_size_override("font_size", int(cfg.get("font_size_min", 0)))
		packs.text = ", ".join(names)
		box.add_child(packs)
		pack_labels.append(packs)
		var licence_keys := licences.keys()
		licence_keys.sort()
		box.add_child(make_label("menu.credits.licence", {"licence": ", ".join(PackedStringArray(licence_keys))}))
	hint_label = make_label("menu.credits.return")
	hint_label.modulate.a = 0.0
	box.add_child(hint_label)


func _tick(_delta: float) -> void:
	if hint_label != null and guard_passed():
		hint_label.modulate.a = 1.0


func authors() -> Array:
	var out: Array = []
	for label in author_labels:
		out.append(String(label.text))
	return out


func pack_text() -> String:
	var parts := PackedStringArray()
	for label in pack_labels:
		parts.append(String(label.text))
	return "\n".join(parts)


func handle_input(event: InputEvent) -> bool:
	if not is_key_press(event):
		return false
	if guard_passed():
		back_pressed.emit()
	return true


func _gui_input(event: InputEvent) -> void:
	if is_click(event) and guard_passed():
		back_pressed.emit()
		accept_event()
