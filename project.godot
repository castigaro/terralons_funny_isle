"events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":4194310), Object(InputEventKey,"physical_keycode":70)]
}

[internationalization]

locale/fallback="en"

[layer_names]

2d_physics/layer_1="world_solid"
2d_physics/layer_2="water"
2d_physics/layer_3="bounds"
2d_physics/layer_4="castaway"
2d_physics/layer_5="animals"
2d_physics/layer_6="items"
2d_physics/layer_7="zones"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.67058825, 0.8901961, 0.9607843, 1)
